rules_version = '2';
// English Dog: un documento de progreso por perfil, perfiles/{pid}.
// - el:     ejesil@gmail.com o un correo que diga «eduardo» (y no «mariana»).
// - ella:   un correo que diga «mariana» o «mariangelica».
// - camila: el botón CAMILA (inicio de sesión anónimo).
// - g_{uid}: cualquier otra cuenta de Google, solo su propio progreso.
// Es una app familiar: cualquiera con un correo que contenga esos nombres entra a ese perfil.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function anon() { return request.auth.token.firebase.sign_in_provider == 'anonymous'; }
    function em() { return request.auth.token.get('email', '').lower(); }
    function verified() { return request.auth.token.get('email_verified', false) == true; }
    function isElla() { return verified() && em() != 'ejesil@gmail.com' && em().matches('.*(mariana|mariangelica).*'); }
    function isEl() { return verified() && (em() == 'ejesil@gmail.com' || (em().matches('.*eduardo.*') && !isElla())); }
    function owns(pid) {
      return signedIn() && (
        (pid == 'el' && isEl()) ||
        (pid == 'ella' && isElla()) ||
        (pid == 'camila' && anon()) ||
        (pid == 'g_' + request.auth.uid && !anon()));
    }

    match /perfiles/{pid} {
      allow get: if owns(pid);
      allow create, update: if owns(pid)
        && request.resource.data.keys().hasOnly(['data', 'updated'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 800000;
    }
  }
}
